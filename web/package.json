{
  "name": "velnix-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun node_modules/vite/bin/vite.js --host 127.0.0.1",
    "typecheck": "bun --bun node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "build": "bun run typecheck && bun --bun node_modules/vite/bin/vite.js build",
    "test:browser": "bun --bun node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  }
}
